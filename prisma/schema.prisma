generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

enum EntityType {
  CUSTOMER_B2B
  CUSTOMER_B2C
  SUPPLIER
  LOGISTICS
}

model Entity {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  type      EntityType
  name      String
  cuil      String?
  email     String
  phone     String
  address   String?
  city      String   @default("Tandil")
  isActive  Boolean  @default(true)
  
  sales     Sale[]   @relation("ClientSales")
  purchases Purchase[] @relation("SupplierPurchases")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
}

model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  sku         String   @unique
  name        String
  description String?
  category    String   @default("General")
  brand       String?  @default("Varias")
  
  costPrice   Decimal  @db.Decimal
  salePrice   Decimal  @db.Decimal
  stock       Int      @default(0)
  minStock    Int      @default(5)
  
  image       String?  // URL de la imagen
  unit        String   @default("UN")
  
  supplierId  String?  @db.ObjectId
  
  saleItems   SaleItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([sku])
  @@index([category])
}

model Sale {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  clientId    String   @db.ObjectId
  client      Entity   @relation("ClientSales", fields: [clientId], references: [id])
  
  items       SaleItem[]
  total       Decimal  @db.Decimal
  discount    Decimal  @db.Decimal @default(0)
  paymentMethod String @default("EFECTIVO")
  
  status      String   @default("PAID") // PAID, PENDING
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clientId])
  @@index([createdAt])
}

model SaleItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  saleId    String   @db.ObjectId
  sale      Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id])
  
  quantity  Int
  unitPrice Decimal  @db.Decimal
  subtotal  Decimal  @db.Decimal
}